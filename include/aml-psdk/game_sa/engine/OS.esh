native class ButtonStateChange = size(0x20)
{
    int buttonIndex = offset(0x0);
    int state = offset(0x4);
    int x = offset(0x8);
    int y = offset(0xc);
    double timeStamp = offset(0x10);
    float force = offset(0x18);
};
native class DateTime = size(0x1c)
{
    int month = offset(0x0);
    int day = offset(0x4);
    int year = offset(0x8);
    int hour = offset(0xc);
    int minute = offset(0x10);
    int second = offset(0x14);
    int centisecond = offset(0x18);
};
native class AND_TouchPoint = size(0x1c)
{
    int x = offset(0x0);
    int y = offset(0x4);
    int state = offset(0x8);
    int clickIndex = offset(0xc);
    float clickTime[2] = offset(0x10);
    int currentUpdateCount = offset(0x18);
};
