#ifndef PSDK_game_sa_engine_RsGlobal_h
#define PSDK_game_sa_engine_RsGlobal_h
#pragma once
// Layouts: GTA SA Android 2.00 ARM32 / 2.10 ARM64; upstream GPL-3.0.
#include "../../sdk_forward.esh"
#include "../../game_sa/plugin.esh"
native class RsGlobalType = size(bits(0x18, 0x20))
{
    uint8_t* appName = offset(0x0);
    int maximumWidth = offset(bits(0x4, 0x8));
    int maximumHeight = offset(bits(0x8, 0xc));
    int maxFPS = offset(bits(0xc, 0x10));
    int quit = offset(bits(0x10, 0x14));
    void* ps = offset(bits(0x14, 0x18));
};
#endif
