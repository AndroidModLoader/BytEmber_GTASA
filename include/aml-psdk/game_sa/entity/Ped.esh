    float GetHealth()
    {
        return m_fHealth;
    }
    float GetMaxHealth()
    {
        return m_fMaxHealth;
    }
    bool IsMaxHealth()
    {
        return GetHealth() >= GetMaxHealth();
    }
    void SetHealth(float hp)
    {
        m_fHealth = hp;
    }
    void AddHealth(float hp)
    {
        SetHealth(GetHealth() + hp);
    }
    void SetHealthSafe(float hp)
    {
        if(hp < 0.0f) m_fHealth = 0.0f;
        else if(hp > GetMaxHealth()) m_fHealth = GetMaxHealth();
        else m_fHealth = hp;
    }
    void AddHealthSafe(float hp)
    {
        SetHealthSafe(GetHealth() + hp);
    }
};
