#include "../../sdk_forward.esh"
#include "../../game_sa/plugin.esh"
#include "../../game_sa/enum/WeaponType.esh"
native class CWeapon = size(bits(0x1c, 0x20))
{
    uint32_t m_eWeaponType = offset(0x0);
    uint32_t m_nState = offset(0x4);
    uint32_t m_nAmmoInClip = offset(0x8);
    uint32_t m_nAmmoTotal = offset(0xc);
    uint32_t m_nTimeForNextShot = offset(0x10);
    uint8_t m_bFirstPersonWeaponModeSelected = offset(0x14);
    uint8_t m_bNoModel = offset(0x15);
    FxSystem_c* m_pFxSystem = offset(0x18);
};
