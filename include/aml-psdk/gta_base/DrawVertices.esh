#include "../sdk_forward.esh"
#include "../renderware/RwRGBA.esh"
native class RwIm2DVertex = size(0x1c)
{
    float x = offset(0x0);
    float y = offset(0x4);
    float z = offset(0x8);
    float rhw = offset(0xc);
    uint8_t r = offset(0x10);
    uint8_t g = offset(0x11);
    uint8_t b = offset(0x12);
    uint8_t a = offset(0x13);
    CRGBA color = offset(0x10);
    uint32_t emissiveColor = offset(0x10);
    float u = offset(0x14);
    float v = offset(0x18);
};
native class RwIm3DVertex = size(0x24)
{
    float x = offset(0x0);
    float y = offset(0x4);
    float z = offset(0x8);
    CVector normal = offset(0xc);
    uint8_t r = offset(0x18);
    uint8_t g = offset(0x19);
    uint8_t b = offset(0x1a);
    uint8_t a = offset(0x1b);
    CRGBA color = offset(0x18);
    uint32_t emissiveColor = offset(0x18);
    float u = offset(0x1c);
    float v = offset(0x20);
};
#endif
