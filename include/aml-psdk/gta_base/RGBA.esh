#pragma once
// Layouts: GTA SA Android 2.00 ARM32 / 2.10 ARM64; upstream GPL-3.0.
#include "../sdk_forward.esh"
#include "../sdk_basetypes.esh"
native class CRGBA = size(0x4)
{
    uint8_t r = offset(0x0);
    uint8_t g = offset(0x1);
    uint8_t b = offset(0x2);
    uint8_t a = offset(0x3);
    uint8_t red = offset(0x0);
    uint8_t green = offset(0x1);
    uint8_t blue = offset(0x2);
    uint8_t alpha = offset(0x3);
};
