native class RpInterpolator = size(0x14)
{
    int flags = offset(0x0);
    int16_t startMorphTarget = offset(0x4);
    int16_t endMorphTarget = offset(0x6);
    float time = offset(0x8);
    float recipTime = offset(0xc);
    float position = offset(0x10);
};
native class RpAtomic = size(bits(0x70, 0xa8))
{
    RwObjectHasFrame object = offset(0x0);
    RwResEntry* repEntry = offset(bits(0x14, 0x28));
    RpGeometry* geometry = offset(bits(0x18, 0x30));
    RwSphere boundingSphere = offset(bits(0x1c, 0x38));
    RwSphere worldBoundingSphere = offset(bits(0x2c, 0x48));
    RpClump* clump = offset(bits(0x3c, 0x58));
    RwLLLink inClumpLink = offset(bits(0x40, 0x60));
    nativeptr renderCallBack = offset(bits(0x48, 0x70));
    RpInterpolator interpolator = offset(bits(0x4c, 0x78));
    uint16_t renderFrame = offset(bits(0x60, 0x8c));
    uint16_t pad = offset(bits(0x62, 0x8e));
    RwLinkList llWorldSectorsInAtomic = offset(bits(0x64, 0x90));
    RxPipeline* pipeline = offset(bits(0x6c, 0xa0));
};
