native class RpClumpChunkInfo = size(0xc)
{
    int numAtomics = offset(0x0);
    int numLights = offset(0x4);
    int numCameras = offset(0x8);
};
native class RpClump = size(bits(0x30, 0x60))
{
    RwObject object = offset(0x0);
    RwLinkList atomicList = offset(bits(0x8, 0x10));
    RwLinkList lightList = offset(bits(0x10, 0x20));
    RwLinkList cameraList = offset(bits(0x18, 0x30));
    RwLLLink inWorldLink = offset(bits(0x20, 0x40));
    nativeptr callback = offset(bits(0x28, 0x50));
    uint16_t renderFrame = offset(bits(0x2c, 0x58));
    uint16_t pad = offset(bits(0x2e, 0x5a));
};
native RpClump* RpClumpForAllAtomics(RpClump* clump, nativeptr callback, void* pData) = symbol("libGTASA.so", "_Z20RpClumpForAllAtomicsP7RpClumpPFP8RpAtomicS2_PvES3_");
