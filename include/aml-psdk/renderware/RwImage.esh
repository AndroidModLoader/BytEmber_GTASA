native class RwImage = size(bits(0x1c, 0x28))
{
    int flags = offset(0x0);
    int width = offset(0x4);
    int height = offset(0x8);
    int depth = offset(0xc);
    int stride = offset(0x10);
    uint8_t* cpPixels = offset(bits(0x14, 0x18));
    CRGBA* palette = offset(bits(0x18, 0x20));
};
native RwImage* RwImageFreePixels(RwImage* image) = symbol("libGTASA.so", "_Z17RwImageFreePixelsP7RwImage");
native RwImage* RwImageAllocatePixels(RwImage* image) = symbol("libGTASA.so", "_Z21RwImageAllocatePixelsP7RwImage");
