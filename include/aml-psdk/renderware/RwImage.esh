native RwImage* RwImageStreamRead(RwStream* stream) = symbol("libGTASA.so", "_Z17RwImageStreamReadP8RwStream");
native RwImage* RwImageStreamWrite(RwImage* image, RwStream* stream) = symbol("libGTASA.so", "_Z18RwImageStreamWritePK7RwImageP8RwStream");
native RwImage* RwImageGammaCorrect(RwImage* image) = symbol("libGTASA.so", "_Z19RwImageGammaCorrectP7RwImage");
