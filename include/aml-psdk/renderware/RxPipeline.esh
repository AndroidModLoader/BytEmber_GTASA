#ifndef PSDK_renderware_RxPipeline_h
#define PSDK_renderware_RxPipeline_h
#pragma once
#define rxPKST_PACKETLESS 0
#define rxPKST_UNUSED 1
#define rxPKST_INUSE 2
#define rxPKST_PENDING 3
// Layouts: GTA SA Android 2.00 ARM32 / 2.10 ARM64; upstream GPL-3.0.
#include "../sdk_forward.esh"
#include "../sdk_base.esh"
#include "../renderware/RwBase.esh"
native class RxPipeline = size(bits(0x34, 0x48))
{
    int locked = offset(0x0);
    uint32_t numNodes = offset(0x4);
    RxPipelineNode* nodes = offset(0x8);
    uint32_t packetNumClusterSlots = offset(bits(0xc, 0x10));
    int embeddedPacketState = offset(bits(0x10, 0x14));
    RxPacket* embeddedPacket = offset(bits(0x14, 0x18));
    uint32_t numInputRequirements = offset(bits(0x18, 0x20));
    RxPipelineRequiresCluster* inputRequirements = offset(bits(0x1c, 0x28));
    void* superBlock = offset(bits(0x20, 0x30));
    uint32_t superBlockSize = offset(bits(0x24, 0x38));
    uint32_t entryPoint = offset(bits(0x28, 0x3c));
    uint32_t pluginId = offset(bits(0x2c, 0x40));
    uint32_t pluginData = offset(bits(0x30, 0x44));
};
#endif
