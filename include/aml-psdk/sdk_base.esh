#ifndef PSDK_sdk_base_h
#define PSDK_sdk_base_h
#pragma once
// Layouts: GTA SA Android 2.00 ARM32 / 2.10 ARM64; upstream GPL-3.0.
#include "sdk_forward.esh"
#include "sdk_basetypes.esh"
#if !ARCH_ARM && !defined(PSDK_LAYOUT_TEST)
#error GTA_SA_PSDK_layouts_require_ARM32_or_ARM64
#endif
uintptr_t g_pMainGameAddress;
uintptr_t GetMainLibraryAddress()
{
    if(g_pMainGameAddress == 0) g_pMainGameAddress = library_base("libGTASA.so");
    return g_pMainGameAddress;
}
#endif
